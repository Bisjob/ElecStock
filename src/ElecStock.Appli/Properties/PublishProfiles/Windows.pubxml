<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows app as a folder to copy anywhere and run (ElecStock.Appli.exe): .NET and the Windows App SDK are inside,
     nothing to install on the PC (Windows 10 1809 or later, x64).
       dotnet publish src/ElecStock.Appli -f net10.0-windows10.0.19041.0 -c Release -p:PublishProfile=Windows -o <folder>
     Not a single exe (PublishSingleFile): it starts after more than a minute (everything is extracted to %TEMP% and run
     from there) and the pages lose their styles. RuntimeIdentifierOverride rather than RuntimeIdentifier: the latter
     would also apply to the Android target at restore (NU1102, no Mono runtime for win-x64). -->
<Project>
	<PropertyGroup>
		<Configuration>Release</Configuration>
		<RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	</PropertyGroup>
</Project>
