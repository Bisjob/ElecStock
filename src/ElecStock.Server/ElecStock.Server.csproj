<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<Description>ElecStock server: web UI, HTTP API for the app, SignalR change feed and MCP endpoint for Claude</Description>
		<UserSecretsId>elecstock-server</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ModelContextProtocol.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<!-- Served by /kicad/sync.ps1 with the server address filled in. -->
		<EmbeddedResource Include="Kicad\sync.ps1" LogicalName="ElecStock.Server.Kicad.sync.ps1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ElecStock.Data\ElecStock.Data.csproj" />
		<ProjectReference Include="..\ElecStock.UI\ElecStock.UI.csproj" />
	</ItemGroup>

	<!-- Container image, built by the .NET SDK (dotnet publish -t:PublishContainer, no Dockerfile).
	     Starts as root like the postgres image: docker-entrypoint.sh gives /app/AppData to the image's "app" user
	     (uid 1654), then runs the server as that user, so a data folder Docker creates for a bind mount works. -->
	<PropertyGroup>
		<ContainerUser>root</ContainerUser>
	</PropertyGroup>

	<ItemGroup>
		<ContainerAppCommand Include="/bin/sh;/app/docker-entrypoint.sh" />
		<None Update="docker-entrypoint.sh" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
