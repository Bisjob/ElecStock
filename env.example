POSTGRES_USER=elecstock
POSTGRES_PASSWORD=change-me
# Address of the web UI as the phones see it: the QR labels of the locations point there
PUBLIC_BASE_URL=http://my-server:4002
# Image: <REPO_URL>/elecstock-server:<ELECSTOCK_TAG> (defaults: ghcr.io/bisjob, latest)
#REPO_URL=ghcr.io/bisjob
#ELECSTOCK_TAG=1.0.0
# Time zone of the containers (default Europe/Paris)
TZ=Europe/Paris
